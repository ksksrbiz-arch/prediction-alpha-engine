# Kalshi (get from https://kalshi.com/)
KALSHI_API_KEY=your_key_here
KALSHI_API_SECRET=your_secret_here
# Or use public endpoints for read-only data initially
KALSHI_REST_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
KALSHI_REQUESTS_PER_SECOND=8

# DB
DATABASE_URL=postgresql://user:pass@localhost:5432/prediction_alpha

# LLM / Agents (local first)
OLLAMA_BASE_URL=http://localhost:11434

# Notification (future)
TELEGRAM_BOT_TOKEN=

# Risk / Sizing
MAX_RISK_PER_TRADE_PCT=1.0
MIN_LIQUIDITY_SCORE=0.20
MIN_VOLUME_24H=100
MAX_DAYS_TO_RESOLUTION=60
MIN_COMPOSITE_SCORE=0.55

# Scoring config YAML (optional — overrides env scoring vars when set)
# SCORING_CONFIG_PATH=scoring_config.yaml

# API
API_HOST=0.0.0.0
API_PORT=8000
